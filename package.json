{
  "name": "bitlab",
  "version": "0.4.0",
  "private": true,
  "description": "BitLab — a multi-network Bitcoin & Lightning teaching lab. Wallets, transaction builder and a real LDK node, with keys that never leave the browser.",
  "license": "MIT",
  "author": "GandalNexus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GandalNexus/bitlab.git"
  },
  "keywords": [
    "bitcoin",
    "lightning-network",
    "ldk",
    "sandbox",
    "education",
    "testnet",
    "signet",
    "wallet",
    "transaction-builder"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "overrides": {
    "minimatch": "^11.0.8",
    "zod": "^4.6.6",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2",
    "@babel/core": "^7.29.1",
    "browserslist": "^4.28.7",
    "@humanfs/node": "^0.16.8",
    "baseline-browser-mapping": "^2.11.0"
  },
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build:regtest-worker": "node scripts/build-regtest-worker.mjs",
    "build": "node scripts/build-regtest-worker.mjs && next build",
    "start": "NODE_ENV=production node .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@scure/btc-signer": "^2.4.1",
    "@tanstack/react-query": "^5.107.1",
    "brace-expansion": "^5.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.72.0",
    "minimatch": "^11.0.8",
    "next": "^16.4.6",
    "picomatch": "^4.0.7",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
