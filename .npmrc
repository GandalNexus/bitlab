# Force npm/bun to install ALL optional dependencies, including platform-specific
# native binaries (lightningcss-linux-x64-gnu, -darwin-x64, …). Without this,
# the Linux binary isn't present when node_modules is bind-mounted from macOS
# into the Docker container, and Tailwind 4 / PostCSS fails to load.
# See GANDALNEXUS/bitquest/docs/DOCKER_DEVELOPMENT.md §8.4 for context.
include=optional
